# Glorious Forge Series One Pro Wireless (CM2852-BAMF) — Board Default Config
# SPDX-License-Identifier: MIT

CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y

# Link at 0x00006000 behind the 24 KB Compx USB HID Bootloader (258a:2103)
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_FLASH_LOAD_OFFSET=0x6000
CONFIG_FLASH_LOAD_SIZE=0x78000

# Enable P0.09 / P0.10 (Side Buttons 4 & 5) as standard GPIOs
CONFIG_NFCT_PINS_AS_GPIOS=y

# Clocks, GPIO, SPI, and USB High-Speed Polling (1,000 Hz = 1 ms interval)
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y
CONFIG_GPIO=y
CONFIG_SPI=y
CONFIG_INPUT=y
CONFIG_ZMK_POINTING=y
CONFIG_ZMK_USB=y
CONFIG_USB_DEVICE_VID=0x258A
CONFIG_USB_DEVICE_PID=0x2018
CONFIG_USB_DEVICE_MANUFACTURER="Glorious"
CONFIG_USB_DEVICE_PRODUCT="Series One PRO [OpenDDPIv1]"
CONFIG_USB_HID_POLL_INTERVAL_MS=1

# Persistent NVS Settings in dedicated 0x0007E000..0x0007FFFF partition
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
CONFIG_NVS=y
CONFIG_SETTINGS=y
CONFIG_SETTINGS_NVS=y

# Enable Open Directional DPI v1 Input Processor
CONFIG_ZMK_INPUT_PROCESSOR_DIRECTIONAL_DPI=y
